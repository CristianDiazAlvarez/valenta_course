# .env - Variables de entorno para docker-compose
# IMPORTANTE: Agregar este archivo a .gitignore

# PostgreSQL
POSTGRES_DB=DB
POSTGRES_USER=USER
POSTGRES_PASSWORD=KEYPASS

# n8n Authentication
N8N_BASIC_AUTH_USER=USER
N8N_BASIC_AUTH_PASSWORD=KEYPASS

# Timezone
TZ=America/Bogota

# Paths
DATA_PATH=PATH

# OpenAI
OPENAI_API_KEY=""


# MinIO (S3)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
S3_BUCKET=raw-data
N8N_USER=n8n_user
N8N_PASSWORD=S3cret-Password!2025
N8N_ACCESS_KEY=n8n_user_access
N8N_SECRET_KEY=n8n_user_secret